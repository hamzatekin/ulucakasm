# Response headers for Workers Static Assets: https://developers.cloudflare.com/workers/static-assets/headers/
# Workers parses this file and does not serve it.

# Pages sent these two on every response by default; Workers does not.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro fingerprints every file under /_astro/, so a given URL never changes.
# Without this, Workers makes the browser revalidate them on every page view.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the workers.dev copies (production and branch Previews) out of search results.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
