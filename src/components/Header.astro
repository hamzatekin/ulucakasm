---
import { Image } from 'astro:assets';
import healthMinistryLogo from '../assets/images/health_ministry-logo.png';
import Icon from './Icon.astro';

const NAV = [
  { label: 'Hizmetler', href: '/#hizmetler' },
  { label: 'Kadromuz', href: '/#kadromuz' },
  { label: 'Merkezimiz', href: '/#merkezimiz' },
  { label: 'İletişim', href: '/#iletisim' },
];
---

<a href="#main-content" class="skip-link">
  İçeriğe geç
</a>

<header class="site-header sticky top-0 z-40 bg-canvas">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex min-w-0 items-center gap-3">
      <Image class="h-9 w-9 shrink-0" src={healthMinistryLogo} alt="T.C. Sağlık Bakanlığı" widths={[48, 72, 96]} sizes="36px" />
      <span class="flex min-w-0 flex-col">
        <span class="truncate text-[15px] leading-5 font-semibold tracking-[-0.01em] text-ink">İbrahim-Hüsniye Özdurakoğlu</span>
        <span class="truncate text-[13px] leading-5 text-ink-2">Aile Sağlığı Merkezi · Ulucak</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Ana menü">
      {NAV.map((item) => (
        <a href={item.href} class="nav-link rounded-full px-3 py-2 text-sm text-ink-2 hover:text-ink">
          {item.label}
        </a>
      ))}
      <a href="/#kadromuz" class="btn-primary ml-3 min-h-9 px-3.5 text-sm">
        Hekiminizi bulun
      </a>
    </nav>

    <button type="button" popovertarget="mobileMenu" class="menu-button btn-ghost -mr-2 size-11 p-0 text-ink lg:hidden" aria-label="Menü">
      <Icon name="menu" class="icon-open h-6 w-6" />
      <Icon name="close" class="icon-close h-6 w-6" />
    </button>
  </div>

  <!-- mobile menu: native popover — light-dismiss, Esc and focus return come from the browser -->
  <div id="mobileMenu" popover class="menu-panel lg:hidden">
    <nav class="flex flex-col" aria-label="Mobil menü">
      {NAV.map((item) => (
        <a href={item.href} class="menu-row">
          {item.label}
        </a>
      ))}
      <a href="/#kadromuz" class="btn-primary mt-2 min-h-12 text-base">
        Hekiminizi bulun
      </a>
    </nav>
  </div>
</header>

<style>
  @reference '../styles/global.css';

  .site-header {
    padding-top: env(safe-area-inset-top, 0px);
    box-shadow: 0 1px 0 var(--color-hairline);
  }
  /* Scroll-driven, zero JS: the hairline under the header fades in over the
     first 48px of scroll, so the header sits flat on the page at rest. */
  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-hairline linear both;
      animation-timeline: scroll();
      animation-range: 0 48px;
    }
  }
  @keyframes header-hairline {
    from {
      box-shadow: 0 1px 0 transparent;
    }
  }

  .nav-link {
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }
  .nav-link[data-active] {
    @apply bg-surface-2 text-ink;
  }

  /* the svgs come from Icon.astro, outside this component's style scope */
  .menu-button :global(.icon-close) {
    display: none;
  }
  .site-header:has(.menu-panel:popover-open) :global(.icon-open) {
    display: none;
  }
  .site-header:has(.menu-panel:popover-open) :global(.icon-close) {
    display: block;
  }

  /* Drops from the menu button (origin top-right), fast in and faster out. */
  .menu-panel {
    position: fixed;
    inset: auto 0.75rem auto auto;
    top: calc(env(safe-area-inset-top, 0px) + 4.25rem);
    width: min(22rem, calc(100vw - 1.5rem));
    margin: 0;
    padding: 0.5rem;
    border: 0;
    border-radius: 18px;
    color: var(--color-ink);
    background: var(--color-surface);
    box-shadow: var(--elev-2);
    transform-origin: top right;
    opacity: 0;
    transform: translateY(-4px) scale(0.97);
    transition:
      opacity 120ms var(--ease-out),
      transform 120ms var(--ease-out),
      overlay 120ms allow-discrete,
      display 120ms allow-discrete;
  }
  .menu-panel:popover-open {
    opacity: 1;
    transform: none;
    transition-duration: 200ms;
  }
  @starting-style {
    .menu-panel:popover-open {
      opacity: 0;
      transform: translateY(-4px) scale(0.97);
    }
  }

  .menu-row {
    @apply flex min-h-12 items-center rounded-xl px-3 text-[17px] text-ink select-none;
    transition: background-color 150ms ease;
  }
  .menu-row:active {
    @apply bg-surface-2;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel,
    .menu-panel:popover-open {
      transform: none;
    }
    @starting-style {
      .menu-panel:popover-open {
        transform: none;
      }
    }
  }
</style>

<script>
  // A tap on a menu link scrolls to its section; close the popover with it.
  const menu = document.getElementById('mobileMenu');
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) menu.hidePopover();
  });

  // Scroll-spy (home page only): highlight the nav link whose section is in view.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-link'));
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) links.forEach((l) => l.toggleAttribute('data-active', l.hash === `#${entry.target.id}`));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  for (const link of links) {
    const section = document.getElementById(link.hash.slice(1));
    if (section) observer.observe(section);
  }
</script>
