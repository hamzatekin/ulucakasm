---
/**
 * Google Maps component — privacy façade / click-to-load.
 * Nothing is requested from Google (no script, no cookies, no visitor IP)
 * until the visitor explicitly clicks "Haritayı göster". This keeps the
 * default page load free of any third-party call, so no çerez/KVKK notice
 * is triggered by the map. Uses the modern AdvancedMarkerElement API.
 */
import { MAPS_LINK } from '../../lib/const.astro';
import Icon from './Icon.astro';
const zoom = 17;
const lat = 38.47771;
const lng = 27.35559;
---

<div class="relative h-[500px] w-full">
  <button
    type="button"
    id="map-load"
    class="absolute inset-0 z-10 flex cursor-pointer flex-col items-center justify-center gap-3 bg-sage/70 text-ink transition-colors hover:bg-sage"
  >
    <Icon name="map-pin" class="h-8 w-8 text-seal" />
    <span class="font-display text-lg font-semibold">Haritayı göster</span>
    <span class="max-w-xs px-6 text-center text-sm text-ink-soft">Tıkladığınızda konumu göstermek için Google Haritalar yüklenir.</span>
  </button>
  <div id="map-container" class="h-full w-full" data-zoom={zoom} data-lat={lat} data-lng={lng}></div>
</div>

<script define:vars={{ MAPS_LINK }}>
  const MAPS_SCRIPT_ID = 'google-maps-js';
  let mapInitialized = false;

  async function initMap() {
    const container = document.getElementById('map-container');
    if (!container || mapInitialized) return;
    if (!window.google?.maps || typeof google.maps.importLibrary !== 'function') return;
    mapInitialized = true;

    const zoom = parseInt(container.dataset.zoom || '17');
    const center = {
      lat: parseFloat(container.dataset.lat || '38.47771'),
      lng: parseFloat(container.dataset.lng || '27.35559'),
    };

    const { Map } = await google.maps.importLibrary('maps');
    const { AdvancedMarkerElement } = await google.maps.importLibrary('marker');

    const map = new Map(container, {
      zoom,
      center,
      mapId: 'ulucak-asm-map', // Required for AdvancedMarkerElement
    });

    new AdvancedMarkerElement({
      position: center,
      map,
      title: 'Kemalpaşa İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi',
    });
  }

  function loadMapsScript() {
    if (document.getElementById(MAPS_SCRIPT_ID)) return;
    const script = document.createElement('script');
    script.id = MAPS_SCRIPT_ID;
    script.src = `${MAPS_LINK}&callback=initMap`;
    script.async = true;
    script.defer = true;
    script.onerror = () => {
      mapInitialized = false;
      console.error('Failed to load Google Maps JS API');
    };
    document.head.appendChild(script);
  }

  // Expose the callback for the Google Maps loader; only fires after a click.
  window.initMap = initMap;

  const btn = document.getElementById('map-load');
  if (btn) {
    btn.addEventListener('click', () => {
      btn.remove();
      if (window.google?.maps && typeof google.maps.importLibrary === 'function') {
        initMap();
      } else {
        loadMapsScript();
      }
    });
  }
</script>
