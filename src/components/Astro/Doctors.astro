---
import { Image } from 'astro:assets';
import Img from './Img.astro';
import Icon from './Icon.astro';
import { DOCTORS, telHref } from '../../lib/staff';

const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/asm/doctors/*.{webp,avif}', { eager: true });
const schedules = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/asm/schedules/*.webp', { eager: true });

const photo = (slug: string) => photos[`../../assets/images/asm/doctors/${slug}.webp`].default;
const schedule = (slug: string) => schedules[`../../assets/images/asm/schedules/${slug}_schedule.webp`].default;

// Screen-reader summary for each weekly schedule image (WCAG 1.1.1). The images
// are dense scanned grids, so a faithful summary alongside the image is the
// accessible equivalent. Window = weekday working hours; keep in sync with the
// images under assets/images/asm/schedules/.
const scheduleWindow: Record<string, string> = {
  murat_tansel_kutluk: '07.00–17.00',
  ilkay_taze: '07.00–18.00',
  ahmet_serhan_sunbul: '07.00–17.00',
  cumhur_citak: '07.00–17.00',
  gokhan_muglali: '08.00–18.00',
  seyhmus_kaya: '08.00–18.00',
};

const TEAM = [
  { name: 'Acil Hemşireleri', img: photos['../../assets/images/asm/doctors/nurses_v2.avif'].default, role: 'Acil müdahale ve bakım' },
  { name: 'Hizmetliler', img: photos['../../assets/images/asm/doctors/support_staff.webp'].default, role: 'Destek ve temizlik ekibi' },
];
---

<section id="kadromuz" class="scroll-mt-24 bg-paper-2 py-20 md:py-28">
  <div class="wrap">
    <header class="max-w-2xl">
      <p class="eyebrow">Kadromuz</p>
      <h2 class="mt-4 font-display text-4xl font-bold tracking-tight text-ink md:text-5xl">Aile hekimleriniz</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">
        Size kayıtlı birimi seçin. Hekiminizi, aile sağlığı çalışanınızı ve çalışma saatlerini görün.
      </p>
    </header>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        DOCTORS.map((d) => (
          <article class="flex flex-col border border-line bg-paper">
            <div class="relative aspect-[4/5] overflow-hidden bg-sage">
              <Image
                src={photo(d.slug)}
                alt={d.name}
                class="h-full w-full object-cover object-top"
                widths={[320, 480, 640]}
                sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw"
                loading="lazy"
                decoding="async"
              />
              <span class="unit-code absolute left-0 top-0 bg-pine-deep px-3 py-2 text-paper">Birim {d.code}</span>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-display text-xl font-semibold leading-tight text-ink">{d.name}</h3>

              <dl class="mt-5 space-y-3 text-sm">
                <div class="flex flex-col gap-0.5">
                  <dt class="font-mono text-[11px] uppercase tracking-[0.14em] text-ink-soft">Aile Sağlığı Çalışanı</dt>
                  <dd class="text-ink">{d.assistant}</dd>
                </div>
              </dl>

              <div class="mt-auto pt-6">
                <a href={telHref(d.phone)} class="flex items-center justify-between border border-line-ink/25 px-4 py-3 transition-colors hover:border-pine hover:bg-sage">
                  <span class="font-mono text-sm tracking-wide text-ink">{d.phone}</span>
                  <Icon name="phone" class="h-4 w-4 text-pine" />
                </a>

                <div class="mt-5">
                  <p class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.14em] text-pine-bright">
                    <Icon name="clock" class="h-4 w-4" />
                    Çalışma saatleri
                  </p>
                  <div class="mt-3 border border-line p-2">
                    <Img src={schedule(d.slug)} alt={`${d.name} haftalık çalışma programı görseli; metin özeti aşağıdadır.`} widths={[420, 720, 1080]} sizes="(min-width: 640px) 360px, 90vw" loading="lazy" decoding="async" />
                  </div>
                  <p class="sr-only">
                    {d.name} çalışma programı: Hafta içi Pazartesi–Cuma, yaklaşık {scheduleWindow[d.slug]} saatleri arasında aile hekimliği hizmeti verilir. Gün içinde
                    bir saat öğle tatili vardır ve belirli saatlerde ev ziyareti yapılır. Cumartesi ve Pazar kapalıdır. Kesin saatler için görseli büyütebilir veya
                    birimi arayabilirsiniz.
                  </p>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- support team -->
    <div class="mt-16 border-t border-line pt-12">
      <p class="eyebrow">Destek ekibimiz</p>
      <div class="mt-6 flex flex-wrap justify-center gap-6">
        {
          TEAM.map((t) => (
            <article class="flex w-full flex-col border border-line bg-paper sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
              <div class="aspect-[4/5] overflow-hidden bg-sage">
                <Image
                  src={t.img}
                  alt={t.name}
                  class="h-full w-full object-cover object-top"
                  widths={[320, 480, 640]}
                  sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="p-6">
                <h3 class="font-display text-xl font-semibold text-ink">{t.name}</h3>
                <p class="mt-1 text-sm text-ink-soft">{t.role}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
