---
import { Image } from 'astro:assets';
import LightboxModal from './LightboxModal.astro';
import frontSide from '../../assets/images/asm/front-side.webp';
import interior1 from '../../assets/images/asm/interior-1.webp';
import interior2 from '../../assets/images/asm/interior-2.webp';
import interior3 from '../../assets/images/asm/interior-3.webp';
import interior4 from '../../assets/images/asm/interior-4.webp';
import interior5 from '../../assets/images/asm/interior-5.webp';

const images = [
  { src: frontSide, alt: 'Ön görünüş', caption: 'Ön görünüş' },
  { src: interior1, alt: 'ASM içi', caption: 'İç mekan' },
  { src: interior2, alt: 'ASM içi', caption: 'İç mekan' },
  { src: interior3, alt: 'ASM içi', caption: 'İç mekan' },
  { src: interior4, alt: 'ASM içi', caption: 'İç mekan' },
  { src: interior5, alt: 'ASM içi', caption: 'İç mekan' },
];
---

<section id="merkezimiz" class="scroll-mt-24 bg-paper py-20 md:py-28">
  <div class="wrap">
    <header class="max-w-2xl">
      <p class="eyebrow">Merkezimiz</p>
      <h2 class="mt-4 font-display text-4xl font-bold tracking-tight text-ink md:text-5xl">Yeni binamız</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">Ulucak'taki modern, kolay ulaşılabilir merkezimizden kareler.</p>
    </header>

    <div class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-3">
      {
        images.map((image, index) => (
          <button
            type="button"
            class={`group relative block overflow-hidden border border-line ${index === 0 ? 'col-span-2 lg:col-span-2 lg:row-span-2' : ''}`}
            onclick={`openLightbox('${image.src.src}', '${image.alt}')`}
            aria-label={`${image.caption} görselini büyüt`}
          >
            <Image
              src={image.src}
              alt={image.alt}
              class={`w-full object-cover transition-transform duration-700 group-hover:scale-105 ${index === 0 ? 'aspect-[4/3] lg:aspect-[16/11]' : 'aspect-[4/3]'}`}
              sizes="(min-width: 1024px) 33vw, 50vw"
              widths={[360, 540, 720, 960]}
              loading="lazy"
              decoding="async"
            />
            <span class="absolute bottom-0 left-0 bg-pine-deep/85 px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.14em] text-paper opacity-0 transition-opacity group-hover:opacity-100">
              {image.caption}
            </span>
          </button>
        ))
      }
    </div>
  </div>
  <LightboxModal />
</section>
