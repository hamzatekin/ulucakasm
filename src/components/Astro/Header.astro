---
import { Image } from 'astro:assets';
import healthMinistryLogo from '../../assets/images/health_ministry-logo.png';
import Icon from './Icon.astro';

const NAV = [
  { label: 'Hizmetler', href: '/#hizmetler' },
  { label: 'Kadromuz', href: '/#kadromuz' },
  { label: 'Merkezimiz', href: '/#merkezimiz' },
  { label: 'İletişim', href: '/#iletisim' },
];
---

<a href="#main-content" class="skip-link">İçeriğe geç</a>

<header class="sticky -top-px z-40">
    <!-- ministry strip -->
    <div class="bg-pine-deep text-sage/75">
      <div class="wrap flex items-center justify-between py-1.5 font-mono text-[11px] uppercase tracking-[0.18em]">
        <span>T.C. Sağlık Bakanlığı</span>
        <span class="hidden sm:inline">İzmir · Kemalpaşa · Ulucak</span>
      </div>
    </div>

    <!-- main bar — solid (backdrop-blur on a sticky element shimmers/jitters
         during scroll in Chromium, so we avoid it) -->
    <div class="border-b border-line bg-paper">
      <div class="wrap flex items-center justify-between gap-4 py-3">
        <a href="/" class="group flex items-center gap-3" aria-label="Ana sayfa">
          <Image class="h-11 w-auto" src={healthMinistryLogo} alt="T.C. Sağlık Bakanlığı" widths={[64, 96, 128]} sizes="64px" decoding="async" />
          <span class="flex flex-col leading-tight">
            <span class="font-display text-sm font-bold text-ink transition-colors group-hover:text-pine md:text-[15px]">
              İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi
            </span>
            <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-ink-soft md:text-[11px]"> T.C. Sağlık Bakanlığı </span>
          </span>
        </a>

        <nav class="hidden items-center gap-7 lg:flex" aria-label="Ana menü">
          {
            NAV.map((item) => (
              <a href={item.href} data-nav class="nav-link font-mono text-xs uppercase tracking-[0.14em] text-ink-soft transition-colors hover:text-pine">
                {item.label}
              </a>
            ))
          }
          <a href="/#kadromuz" class="btn-primary text-xs">Hekimlerimiz</a>
        </nav>

        <button id="menuButton" class="text-pine lg:hidden" aria-label="Menüyü aç" aria-expanded="false" aria-controls="mobileMenu">
          <span data-icon-open><Icon name="menu" class="h-7 w-7" /></span>
          <span data-icon-close class="hidden"><Icon name="close" class="h-7 w-7" /></span>
        </button>
      </div>

      <!-- mobile menu -->
      <div id="mobileMenu" class="hidden border-t border-line lg:hidden">
        <nav class="wrap flex flex-col py-2" aria-label="Mobil menü">
          {
            NAV.map((item) => (
              <a href={item.href} data-nav-mobile class="border-b border-line/70 py-3 font-mono text-sm uppercase tracking-[0.12em] text-ink last:border-0">
                {item.label}
              </a>
            ))
          }
          <a href="/#kadromuz" data-nav-mobile class="btn-primary mt-3 mb-2">Hekimlerimiz</a>
        </nav>
      </div>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

<style>
  @reference '../../styles/global.css';

  /* Cover the ~1px gap Chromium can leave above a `position: sticky` element on
     fractional-DPR displays / non-100% zoom: bleed the header's top colour
     (the ministry strip) a few px upward so any sub-pixel seam is filled. */
  header::before {
    content: '';
    position: absolute;
    inset: -4px 0 auto 0;
    height: 4px;
    background: var(--color-pine-deep);
  }

  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    height: 2px;
    width: 0;
    background: var(--color-seal);
    transition: width 0.25s ease;
  }
  .nav-link:hover::after,
  .nav-link[data-active]::after {
    width: 100%;
  }
  .nav-link[data-active] {
    @apply text-pine;
  }
</style>

<script>
  function initHeader() {
    const btn = document.getElementById('menuButton');
    const menu = document.getElementById('mobileMenu');

    // dataset.bound keeps binding idempotent so each tap toggles the menu
    // exactly once (guards against the script running more than once).
    if (btn && menu && btn.dataset.bound !== '1') {
      btn.dataset.bound = '1';
      const iconOpen = btn.querySelector('[data-icon-open]');
      const iconClose = btn.querySelector('[data-icon-close]');

      const setMenu = (open: boolean) => {
        menu.classList.toggle('hidden', !open);
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
      };

      btn.addEventListener('click', () => setMenu(menu.classList.contains('hidden')));
      menu.querySelectorAll('[data-nav-mobile]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false);
      });
    }

    // scroll-spy: highlight the section currently in view (home page only)
    const links = Array.from(document.querySelectorAll('[data-nav]')) as HTMLAnchorElement[];
    const sections = ['hizmetler', 'kadromuz', 'merkezimiz', 'iletisim']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (!sections.length || !links.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((l) => {
            l.toggleAttribute('data-active', l.getAttribute('href') === `/#${entry.target.id}`);
          });
        });
      },
      { rootMargin: '-45% 0px -50% 0px' }
    );
    sections.forEach((s) => observer.observe(s));
  }

  // Native cross-document navigation reloads the document each time, so this
  // module runs on every page load; the dataset guard keeps it idempotent.
  initHeader();
</script>
