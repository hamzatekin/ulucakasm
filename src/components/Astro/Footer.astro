---
import { version } from '../../../package.json';
import Icon from './Icon.astro';
const currentYear = new Date().getFullYear();
const VERSION = `v${version}`;

const tel = (p: string) => `tel:${p.replace(/[^0-9+]/g, '')}`;

const DIRECTORY = [
  {
    title: 'Merkez',
    address: 'Mustafa Kemal Atatürk Mah. 9247 Sok. No:3, Ulucak, Kemalpaşa / İzmir',
    web: { label: 'www.ism.gov.tr', href: 'https://www.ism.gov.tr' },
    phones: ['+90 (232) 873 40 74', '+90 (232) 873 40 81'],
  },
  {
    title: 'İlçe Sağlık Müdürlüğü',
    address: 'Soğukpınar, Atatürk Blv. No:2, 35730 Kemalpaşa / İzmir',
    web: { label: 'kemalpasasm.ism.gov.tr', href: 'https://kemalpasasm.ism.gov.tr/' },
    phones: ['+90 (232) 878 11 02'],
  },
  {
    title: 'İl Sağlık Müdürlüğü',
    address: 'Sümer Mah. 451 Sok. No:2, Konak / İzmir',
    web: { label: 'www.ism.gov.tr', href: 'https://www.ism.gov.tr' },
    phones: ['+90 (232) 411 81 11'],
  },
];
---

<footer class="bg-ink text-sage/70">
  <div class="wrap py-16">
    <div class="flex flex-col gap-2 border-b border-line-ink/30 pb-10">
      <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-sage/65">T.C. Sağlık Bakanlığı</span>
      <span class="font-display text-2xl font-bold text-paper md:text-3xl">İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi</span>
      <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-sage/65">Kemalpaşa . Ulucak </span>
    </div>

    <div class="grid gap-10 py-10 md:grid-cols-3">
      {
        DIRECTORY.map((d) => (
          <div>
            <h3 class="eyebrow-on-dark">{d.title}</h3>
            <div class="mt-4 space-y-3 text-sm leading-relaxed">
              <p class="flex gap-3">
                <Icon name="map-pin" class="mt-0.5 h-4 w-4 flex-shrink-0 text-seal-soft" />
                <span>{d.address}</span>
              </p>
              <p class="flex gap-3">
                <Icon name="external" class="mt-0.5 h-4 w-4 flex-shrink-0 text-seal-soft" />
                <a href={d.web.href} target="_blank" rel="noopener noreferrer" class="ulink text-sage/85 decoration-line-ink/40 hover:text-paper">
                  {d.web.label}
                </a>
              </p>
              {d.phones.map((p) => (
                <p class="flex gap-3">
                  <Icon name="phone" class="mt-0.5 h-4 w-4 flex-shrink-0 text-seal-soft" />
                  <a href={tel(p)} class="font-mono tracking-wide text-sage/85 hover:text-paper">
                    {p}
                  </a>
                </p>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="flex flex-col gap-4 border-t border-line-ink/30 pt-8 text-xs text-sage/65 md:flex-row md:items-center md:justify-between">
      <span class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-4">
        <span>Kemalpaşa İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi</span>
        <a href="/erisilebilirlik" class="ulink text-sage/85 decoration-line-ink/40 hover:text-paper">Erişilebilirlik</a>
      </span>
      <span class="flex items-center gap-3 font-mono uppercase tracking-[0.14em]">
        <span>{VERSION}</span>
        <span class="text-sage/30">/</span>
        <a href="https://avvossoft.com" target="_blank" rel="noopener noreferrer" class="hover:text-paper">Avvossoft {currentYear}</a>
      </span>
    </div>
  </div>
</footer>
