---
import { Image } from 'astro:assets';
import frontSide from '../../assets/images/asm/front-side.webp';
import Icon from './Icon.astro';

const DIRECTIONS = 'https://www.google.com/maps/search/?api=1&query=38.47771,27.35559';
---

<!-- First visit is rare for a patient, so the hero gets the page's one entrance:
     a short 60ms stagger, under the delight budget, fades only with reduced motion. -->
<section class="pt-10 pb-16 md:pt-16 md:pb-24">
  <div class="wrap grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <div>
      <p class="animate-enter text-sm text-ink-2">T.C. Sağlık Bakanlığı · Kemalpaşa, Ulucak</p>

      <h1 class="animate-enter mt-4 text-display text-ink" style="animation-delay: 60ms">
        Kemalpaşa İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi
      </h1>

      <p class="animate-enter mt-6 max-w-[58ch] text-lead text-ink-2" style="animation-delay: 120ms">
        Kemalpaşa'daki modern ve kolay ulaşılabilir yeni binamızda koruyucu sağlık hizmeti, bağışıklama ve ayaktan tedavi sunuyor;
        hastalarımıza gereken ilgi ve özeni göstermeye özen gösteriyoruz.
      </p>

      <div class="animate-enter mt-8 flex flex-wrap items-center gap-3" style="animation-delay: 180ms">
        <a href="#kadromuz" class="btn-primary group">
          Hekiminizi bulun
          <Icon name="arrow" class="h-4 w-4 transition-transform duration-200 ease-out group-hover:translate-x-0.5" />
        </a>
        <a href={DIRECTIONS} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          <Icon name="map-pin" class="h-4 w-4 text-ink-2" />
          Yol tarifi
        </a>
      </div>

      <p class="animate-enter mt-8 text-sm text-ink-2" style="animation-delay: 240ms">
        Randevu için <span class="font-medium text-ink">MHRS</span> veya <span class="font-medium text-ink">ALO 182</span>
      </p>
    </div>

    <figure class="animate-enter-image" style="animation-delay: 80ms">
      <div class="card overflow-hidden p-2">
        <Image
          src={frontSide}
          alt="Kemalpaşa İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi binası"
          class="aspect-[4/3] w-full rounded-[12px] object-cover object-[center_30%] lg:aspect-[5/6]"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 460px, 90vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption class="mt-3 px-1 text-[13px] text-ink-3">Mustafa Kemal Atatürk Mah. 9247 Sok. No:3</figcaption>
    </figure>
  </div>
</section>
