---
import { Image } from 'astro:assets';
import frontSide from '../../assets/images/asm/front-side.webp';
import Icon from './Icon.astro';
---

<section class="bg-pine-deep text-paper">
  <div class="wrap grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
    <!-- left: the pitch -->
    <div>
      <p class="eyebrow-on-dark reveal">Ulucak · Kemalpaşa · T.C. Sağlık Bakanlığı</p>

      <h1 class="reveal reveal-2 mt-6 font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-paper md:text-5xl">
        Kemalpaşa İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi
      </h1>

      <p class="reveal reveal-3 mt-7 max-w-xl text-lg leading-relaxed text-sage/85">
        Kemalpaşa'daki modern ve kolay ulaşılabilir yeni binamızda koruyucu sağlık hizmeti, bağışıklama ve ayaktan tedavi sunuyor;
        hastalarımıza gereken ilgi ve özeni göstermeye özen gösteriyoruz.
      </p>

      <div class="reveal reveal-3 mt-9 flex flex-wrap items-center gap-3">
        <a href="#kadromuz" class="btn-primary">Hekimlerimiz <Icon name="arrow" class="h-4 w-4" /></a>
        <a href="#iletisim" class="btn-line-light">Yol tarifi · İletişim</a>
      </div>
    </div>

    <!-- right: the building itself -->
    <div class="reveal reveal-2 relative">
      <div class="absolute -left-3 -top-3 hidden h-16 w-16 border-l-2 border-t-2 border-seal md:block"></div>
      <div class="overflow-hidden">
        <Image
          src={frontSide}
          alt="Kemalpaşa İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi binası"
          class="h-full w-full object-cover"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 520px, 90vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.16em] text-sage/75">Mustafa Kemal Atatürk Mah. · Ulucak</p>
    </div>
  </div>
</section>
