---
import Icon from './Icon.astro';
---

<dialog id="lightbox" class="lightbox-modal" aria-label="Görsel önizleme">
  <img id="lightboxImage" src="" alt="" />
  <button type="button" id="closeLightbox" aria-label="Kapat">
    <Icon name="close" class="h-5 w-5" />
  </button>
</dialog>

<style>
  /* native <dialog>: keyboard focus trap, Esc-to-close and backdrop come for free.
     A modal stays centred; it fades in with the photo settling from 0.96 and
     leaves faster than it arrives. */
  .lightbox-modal {
    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100dvh;
    margin: 0;
    padding: 1rem;
    border: none;
    background: transparent;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition:
      opacity 150ms var(--ease-out),
      overlay 150ms allow-discrete,
      display 150ms allow-discrete;
  }
  .lightbox-modal[open] {
    display: flex;
    opacity: 1;
    transition-duration: 220ms;
  }
  @starting-style {
    .lightbox-modal[open] {
      opacity: 0;
    }
  }
  .lightbox-modal::backdrop {
    background: rgb(6 9 8 / 0);
    transition:
      background-color 150ms ease,
      overlay 150ms allow-discrete,
      display 150ms allow-discrete;
  }
  .lightbox-modal[open]::backdrop {
    background: rgb(6 9 8 / 0.9);
  }
  @starting-style {
    .lightbox-modal[open]::backdrop {
      background: rgb(6 9 8 / 0);
    }
  }

  #lightboxImage {
    max-height: 88dvh;
    max-width: min(92vw, 1400px);
    object-fit: contain;
    border-radius: 12px;
    transform: scale(0.96);
    transition: transform 220ms var(--ease-out);
  }
  .lightbox-modal[open] #lightboxImage {
    transform: none;
  }
  @starting-style {
    .lightbox-modal[open] #lightboxImage {
      transform: scale(0.96);
    }
  }

  #closeLightbox {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 0.75rem);
    right: calc(env(safe-area-inset-right, 0px) + 0.75rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: none;
    border-radius: 9999px;
    color: #fff;
    background: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    cursor: pointer;
    transition:
      transform 160ms var(--ease-out),
      background-color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    #closeLightbox:hover {
      background: rgb(255 255 255 / 0.2);
    }
  }
  #closeLightbox:active {
    transform: scale(0.94);
  }

  @media (prefers-reduced-motion: reduce) {
    #lightboxImage,
    .lightbox-modal[open] #lightboxImage,
    #closeLightbox:active {
      transform: none;
    }
    @starting-style {
      .lightbox-modal[open] #lightboxImage {
        transform: none;
      }
    }
  }
</style>

<script>
  function initLightboxModal() {
    const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
    const lightboxImage = document.getElementById('lightboxImage') as HTMLImageElement | null;
    const closeLightbox = document.getElementById('closeLightbox');
    if (!lightbox || !lightboxImage) return;

    // Global entry point used by Gallery's thumbnail buttons.
    window.openLightbox = (src: string, alt: string) => {
      lightboxImage.src = src;
      lightboxImage.alt = alt;
      // showModal() traps focus, enables Esc, and restores focus to the
      // trigger on close — all natively.
      if (!lightbox.open) lightbox.showModal();
    };

    closeLightbox?.addEventListener('click', () => lightbox.close());

    // Click on the backdrop (outside the image) closes.
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) lightbox.close();
    });
  }

  initLightboxModal();
</script>
