---
import Icon from './Icon.astro';

const SERVICES = [
  {
    title: 'Koruyucu Sağlık Hizmeti',
    desc: 'Düzenli kontroller, tarama ve sağlıklı yaşam danışmanlığı.',
    href: '/beslenme',
    linkLabel: 'Beslenme rehberi',
  },
  {
    title: 'Bağışıklama',
    desc: 'Bebek, çocuk ve erişkin aşıları; güncel aşı takvimi.',
    href: '/bagisiklama',
    linkLabel: 'Aşı takvimi',
  },
  {
    title: 'Ayaktan Tedavi',
    desc: 'Muayene, tanı ve reçete ile günlük ayaktan tedavi.',
  },
  {
    title: 'İlk Yardım',
    desc: 'Acil durumlarda ilk müdahale ve doğru birime yönlendirme.',
  },
];
---

<section id="hizmetler" class="scroll-mt-24 bg-paper py-20 md:py-28">
  <div class="wrap">
    <header class="max-w-2xl">
      <p class="eyebrow">Hizmetler</p>
      <h2 class="mt-4 font-display text-4xl font-bold tracking-tight text-ink md:text-5xl">Merkezimizde neler var</h2>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">
        Aile hekimliğinin temel görevleri: doğumdan yaşlılığa, aynı çatı altında.
      </p>
    </header>

    <div class="mt-12 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2">
      {
        SERVICES.map((s) =>
          s.href ? (
            <a href={s.href} class="group flex flex-col bg-paper p-8 transition-colors hover:bg-sage md:p-10">
              <h3 class="font-display text-2xl font-semibold text-ink">{s.title}</h3>
              <p class="mt-3 flex-1 text-ink-soft">{s.desc}</p>
              <span class="mt-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.14em] text-pine-bright">
                {s.linkLabel}
                <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          ) : (
            <div class="flex flex-col bg-paper p-8 md:p-10">
              <h3 class="font-display text-2xl font-semibold text-ink">{s.title}</h3>
              <p class="mt-3 flex-1 text-ink-soft">{s.desc}</p>
            </div>
          )
        )
      }
    </div>
  </div>
</section>
