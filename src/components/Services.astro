---
import Icon from './Icon.astro';

const SERVICES = [
  {
    title: 'Koruyucu Sağlık Hizmeti',
    desc: 'Düzenli kontroller, tarama ve sağlıklı yaşam danışmanlığı.',
    href: '/beslenme',
    linkLabel: 'Beslenme rehberi',
  },
  {
    title: 'Bağışıklama',
    desc: 'Bebek, çocuk ve erişkin aşıları; güncel aşı takvimi.',
    href: '/bagisiklama',
    linkLabel: 'Aşı takvimi',
  },
  {
    title: 'Ayaktan Tedavi',
    desc: 'Muayene, tanı ve reçete ile günlük ayaktan tedavi.',
  },
  {
    title: 'İlk Yardım',
    desc: 'Acil durumlarda ilk müdahale ve doğru birime yönlendirme.',
  },
];
---

<section id="hizmetler" class="scroll-mt-20 py-14 md:py-20">
  <div class="wrap">
    <h2 class="max-w-[46rem] text-title text-ink">
      Merkezimizde neler var. <span class="text-ink-3">Doğumdan yaşlılığa, aynı çatı altında.</span>
    </h2>

    <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        SERVICES.map((s) => {
          // a service with a guide page is a link card; the others are plain cards
          const Card = s.href ? 'a' : 'div';
          return (
            <Card href={s.href} class:list={[s.href ? 'card-link group' : 'card', 'flex flex-col p-6']}>
              <h3 class="text-lg font-semibold tracking-[-0.01em] text-ink">{s.title}</h3>
              <p class="mt-2 flex-1 text-[15px] leading-relaxed text-ink-2">{s.desc}</p>
              {s.href && (
                <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
                  {s.linkLabel}
                  <Icon name="arrow" class="h-4 w-4 transition-transform duration-200 ease-out group-hover:translate-x-0.5" />
                </span>
              )}
            </Card>
          );
        })
      }
    </div>
  </div>
</section>
