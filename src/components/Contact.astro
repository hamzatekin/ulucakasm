---
import Maps from './Maps.astro';
import Icon from './Icon.astro';
import { ADDRESS, DIRECTIONS, PHONES, telHref } from '../lib/clinic';
---

<section id="iletisim" class="scroll-mt-20 py-14 md:py-20">
  <div class="wrap">
    <h2 class="reveal max-w-[46rem] text-title text-ink">
      Bize ulaşın. <span class="text-ink-3">Adres, telefon ve randevu.</span>
    </h2>

    <div class="card reveal mt-10 grid gap-2 p-2 lg:grid-cols-[0.85fr_1.15fr]">
      <dl class="flex flex-col divide-y divide-hairline px-4 py-2 md:px-6">
        <div class="py-5">
          <dt class="flex items-center gap-2 text-sm text-ink-2">
            <Icon name="map-pin" class="h-4 w-4 text-accent" />
            Adres
          </dt>
          <dd class="mt-2 text-lg leading-snug text-ink">{ADDRESS}</dd>
          <dd class="mt-5 text-sm text-ink-2">Yol tarifi al</dd>
          <!-- three equal columns on a phone (text only, so it never wraps); natural widths with the icon from sm up -->
          <dd class="mt-2 grid grid-cols-3 gap-2 sm:flex sm:flex-wrap">
            {DIRECTIONS.map((d) => (
              <a
                href={d.href}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-secondary gap-1.5 px-2 sm:px-4"
                aria-label={`${d.name} ile yol tarifi (yeni sekmede açılır)`}
              >
                {d.app}
                <Icon name="external" class="hidden h-4 w-4 shrink-0 text-ink-2 sm:block" />
              </a>
            ))}
          </dd>
        </div>

        <div class="py-5">
          <dt class="flex items-center gap-2 text-sm text-ink-2">
            <Icon name="phone" class="h-4 w-4 text-accent" />
            Telefon
          </dt>
          <dd class="mt-3 flex flex-wrap gap-2">
            {PHONES.map((p) => (
              <a href={telHref(p)} class="btn-secondary tabular-nums">
                {p}
              </a>
            ))}
          </dd>
        </div>

        <div class="py-5">
          <dt class="flex items-center gap-2 text-sm text-ink-2">
            <Icon name="clock" class="h-4 w-4 text-accent" />
            Randevu
          </dt>
          <dd class="mt-2 text-lg text-ink">MHRS · ALO 182</dd>
          <dd class="mt-1 text-[15px] text-ink-2">Hafta içi mesai saatleri içinde hizmet verilmektedir.</dd>
          <dd class="mt-3 text-[15px] text-ink-2">
            Sağlık kayıtlarınız:{' '}
            <a href="https://enabiz.gov.tr" target="_blank" rel="noopener noreferrer" class="ulink">
              e-Nabız
            </a>
          </dd>
        </div>
      </dl>

      <div class="overflow-hidden rounded-[12px]">
        <Maps />
      </div>
    </div>
  </div>
</section>
