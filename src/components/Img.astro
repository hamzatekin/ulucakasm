---
/**
 * Image with a zoomable lightbox (vanilla JS, no framework).
 * Tap the trigger to open full-screen; tap the image to zoom in/out and
 * pan by dragging/scrolling. Used for document-like images (schedules, calendars).
 *
 * `label` switches the trigger from a full-width thumbnail to a compact row
 * (small thumbnail + label), for places where the scan itself is too dense
 * to read inline — e.g. a doctor's weekly schedule.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  label?: string;
  hint?: string;
  widths?: number[];
  sizes?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  decoding?: 'sync' | 'async' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { src, alt, label, hint, ...imageProps } = Astro.props;
const imageId = `img-${Math.random().toString(36).substring(2, 9)}`;
---

{
  label ? (
    <button type="button" class="row-trigger" data-lightbox-trigger={imageId}>
      <span class="row-thumb">
        <Image src={src} alt="" widths={[96, 144]} sizes="72px" loading="lazy" decoding="async" />
      </span>
      <span class="flex min-w-0 flex-1 flex-col text-left">
        <span class="text-[15px] font-medium text-ink">{label}</span>
        {hint && <span class="text-[13px] text-ink-2">{hint}</span>}
      </span>
      <Icon name="expand" class="h-4 w-4 shrink-0 text-ink-3" />
      <span class="sr-only">{alt}</span>
    </button>
  ) : (
    <button type="button" class="thumbnail" data-lightbox-trigger={imageId} aria-label={`${alt} görselini büyüt`}>
      <Image src={src} alt={alt} {...imageProps} />
      <span class="thumb-badge" aria-hidden="true">
        <Icon name="expand" class="h-3.5 w-3.5" />
        Büyüt
      </span>
    </button>
  )
}

<dialog id={`dialog-${imageId}`} class="lightbox" aria-label={alt}>
  <div class="lb-scroll" data-lb-scroll>
    <Image class="lb-img" src={src} alt={alt} {...imageProps} sizes="100vw" />
  </div>
  <button type="button" class="lb-close" aria-label="Kapat">
    <Icon name="close" class="h-5 w-5" />
  </button>
  <p class="lb-hint" data-lb-hint>Yakınlaştırmak için görsele dokunun</p>
</dialog>

<style>
  @reference '../styles/global.css';

  /* compact row trigger */
  .row-trigger {
    @apply flex w-full items-center gap-3 rounded-[12px] bg-surface-2 p-2 pr-4 select-none;
    cursor: zoom-in;
    transition:
      transform 160ms var(--ease-out),
      background-color 150ms ease;
  }
  .row-trigger:active {
    transform: scale(0.98);
  }
  @media (hover: hover) and (pointer: fine) {
    .row-trigger:hover {
      background-color: color-mix(in oklab, var(--color-surface-2), var(--color-ink) 4%);
    }
  }
  .row-thumb {
    @apply block h-12 w-[4.5rem] shrink-0 overflow-hidden rounded-[6px] bg-surface;
    box-shadow: 0 0 0 1px var(--color-hairline);
  }
  .row-thumb img {
    @apply h-full w-full object-cover object-top;
  }

  /* full-width thumbnail trigger */
  .thumbnail {
    position: relative;
    display: block;
    width: 100%;
    cursor: zoom-in;
    border: none;
    background: none;
    padding: 0;
  }
  .thumbnail img {
    width: 100%;
    height: auto;
    display: block;
  }
  .thumb-badge {
    @apply absolute right-2 bottom-2 inline-flex h-7 items-center gap-1.5 rounded-full px-2.5 text-xs font-medium text-white;
    background: rgb(12 16 14 / 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    pointer-events: none;
  }

  /* Lightbox: a modal, so it stays centred (no trigger origin). Fades in with
     the image settling from 0.96; exits faster than it enters. */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overscroll-behavior: contain;
    opacity: 0;
    transition:
      opacity 150ms var(--ease-out),
      overlay 150ms allow-discrete,
      display 150ms allow-discrete;
  }
  .lightbox[open] {
    opacity: 1;
    transition-duration: 220ms;
  }
  @starting-style {
    .lightbox[open] {
      opacity: 0;
    }
  }
  .lightbox::backdrop {
    background: rgb(6 9 8 / 0);
    transition:
      background-color 150ms ease,
      overlay 150ms allow-discrete,
      display 150ms allow-discrete;
  }
  .lightbox[open]::backdrop {
    background: rgb(6 9 8 / 0.9);
  }
  @starting-style {
    .lightbox[open]::backdrop {
      background: rgb(6 9 8 / 0);
    }
  }

  .lb-scroll {
    position: absolute;
    inset: 0;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    display: flex;
    align-items: safe center;
    justify-content: safe center;
  }
  .lb-img {
    display: block;
    margin: auto;
    max-width: 100%;
    max-height: 100dvh;
    object-fit: contain;
    cursor: zoom-in;
    user-select: none;
    transform: scale(0.96);
    transition: transform 220ms var(--ease-out);
  }
  .lightbox[open] .lb-img {
    transform: none;
  }
  @starting-style {
    .lightbox[open] .lb-img {
      transform: scale(0.96);
    }
  }
  .lb-img.is-zoomed {
    max-width: none;
    max-height: none;
    width: min(1600px, 230vw);
    height: auto;
    cursor: zoom-out;
  }

  .lb-close {
    @apply fixed z-[2] inline-flex size-11 items-center justify-center rounded-full text-white;
    top: calc(env(safe-area-inset-top, 0px) + 0.75rem);
    right: calc(env(safe-area-inset-right, 0px) + 0.75rem);
    background: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      transform 160ms var(--ease-out),
      background-color 150ms ease;
  }
  .lb-close:active {
    transform: scale(0.94);
  }
  @media (hover: hover) and (pointer: fine) {
    .lb-close:hover {
      background: rgb(255 255 255 / 0.2);
    }
  }

  .lb-hint {
    @apply fixed left-1/2 z-[2] m-0 rounded-full px-3 py-1.5 text-[13px] whitespace-nowrap text-white/90;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 1rem);
    transform: translateX(-50%);
    background: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    pointer-events: none;
    transition: opacity 200ms ease;
  }
  .lb-hint.is-hidden {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .row-trigger:active,
    .lb-close:active,
    .lb-img,
    .lightbox[open] .lb-img {
      transform: none;
    }
    @starting-style {
      .lightbox[open] .lb-img {
        transform: none;
      }
    }
  }
</style>

<script>
  function initLightboxes() {
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]').forEach((button) => {
      if (button.dataset.lbBound === '1') return;
      button.dataset.lbBound = '1';

      const id = button.getAttribute('data-lightbox-trigger');
      const dialog = document.getElementById(`dialog-${id}`) as HTMLDialogElement | null;
      if (!dialog) return;

      const img = dialog.querySelector('.lb-img') as HTMLImageElement | null;
      const scroll = dialog.querySelector('[data-lb-scroll]') as HTMLElement | null;
      const closeBtn = dialog.querySelector('.lb-close') as HTMLButtonElement | null;
      const hint = dialog.querySelector('[data-lb-hint]') as HTMLElement | null;
      if (!img || !scroll) return;

      const reset = () => {
        img.classList.remove('is-zoomed');
        hint?.classList.remove('is-hidden');
      };

      button.addEventListener('click', () => {
        reset();
        dialog.showModal();
      });

      // tap image → toggle zoom, centering on the tapped point
      img.addEventListener('click', (e) => {
        e.stopPropagation();
        const rect = img.getBoundingClientRect();
        const ratioX = (e.clientX - rect.left) / rect.width;
        const ratioY = (e.clientY - rect.top) / rect.height;
        const zoomed = img.classList.toggle('is-zoomed');
        hint?.classList.add('is-hidden');
        if (zoomed) {
          requestAnimationFrame(() => {
            scroll.scrollLeft = ratioX * (scroll.scrollWidth - scroll.clientWidth);
            scroll.scrollTop = ratioY * (scroll.scrollHeight - scroll.clientHeight);
          });
        }
      });

      // tap outside the image closes
      scroll.addEventListener('click', () => dialog.close());
      closeBtn?.addEventListener('click', () => dialog.close());
      // zoom state resets on the next open, not on close, so the image
      // doesn't snap back to fit while the dialog is still fading out
    });
  }

  initLightboxes();
</script>
