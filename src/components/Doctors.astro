---
import { Image } from 'astro:assets';
import Img from './Img.astro';
import Icon from './Icon.astro';
import { DOCTORS, doctorId, telHref } from '../lib/clinic';
import nurses from '../assets/images/asm/doctors/nurses_v2.avif';
import supportStaff from '../assets/images/asm/doctors/support_staff.webp';

// Doctor photos and schedules are looked up by slug (see lib/clinic.ts).
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/images/asm/doctors/*.webp', { eager: true });
const schedules = import.meta.glob<{ default: ImageMetadata }>('../assets/images/asm/schedules/*.webp', { eager: true });
const photo = (slug: string) => photos[`../assets/images/asm/doctors/${slug}.webp`].default;
const schedule = (slug: string) => schedules[`../assets/images/asm/schedules/${slug}_schedule.webp`].default;

// Each doctor photo is a 3:4 portrait shown as a 4:3 crop, and the people stand at different heights in each.
// These move the crop so the highest face sits about a quarter of the way down every card (face positions
// measured with macOS Vision). A new photo needs its own value: the build stops without one.
const PHOTO_CROP: Record<string, string> = {
  murat_tansel_kutluk: 'object-[center_37%]',
  ilkay_taze: 'object-[center_62%]',
  ahmet_serhan_sunbul: 'object-[center_47%]',
  cumhur_citak: 'object-[center_40%]',
  gokhan_muglali: 'object-[center_33%]',
  seyhmus_kaya: 'object-[center_22%]',
};
const photoCrop = (slug: string) => {
  const crop = PHOTO_CROP[slug];
  if (!crop) throw new Error(`Doctors.astro: no PHOTO_CROP entry for "${slug}"`);
  return crop;
};

// Both are 9:16 portraits shown as a 4:3 crop; `crop` follows the same quarter-of-the-way-down rule as PHOTO_CROP.
const TEAM = [
  { name: 'Acil Hemşireleri', img: nurses, role: 'Acil müdahale ve bakım', crop: 'object-[center_30%]' },
  { name: 'Hizmetliler', img: supportStaff, role: 'Destek ve temizlik ekibi', crop: 'object-[center_50%]' },
];
---

<section id="kadromuz" class="scroll-mt-20 py-14 md:py-20">
  <div class="wrap">
    <h2 class="reveal max-w-[46rem] text-title text-ink">
      Aile hekimleriniz. <span class="text-ink-3">Size kayıtlı birimi bulun.</span>
    </h2>

    <!-- jump straight to a doctor's card; the card briefly rings on arrival (CSS :target, no JS) -->
    <nav class="reveal mt-6 flex flex-wrap gap-2" aria-label="Hekim listesi">
      {DOCTORS.map((d) => (
        <a href={`#${doctorId(d.slug)}`} class="btn-secondary min-h-9 rounded-full px-3.5 text-sm">
          {d.name}
        </a>
      ))}
    </nav>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {DOCTORS.map((d) => (
        <article id={doctorId(d.slug)} class="doctor card reveal flex scroll-mt-24 flex-col p-2">
          <div class="relative overflow-hidden rounded-[12px] bg-surface-2">
            <Image
              src={photo(d.slug)}
              alt={d.name}
              class:list={['aspect-[4/3] w-full object-cover', photoCrop(d.slug)]}
              widths={[320, 480, 640, 760]}
              sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 92vw"
            />
            <span class="chip absolute top-2.5 left-2.5 bg-surface/85 text-ink backdrop-blur-md">
              <span class="text-ink-2">Birim</span> {d.code}
            </span>
          </div>

          <div class="flex flex-1 flex-col px-3 pt-4 pb-1">
            <h3 class="text-lg font-semibold tracking-[-0.01em] text-ink">{d.name}</h3>
            <p class="mt-1 text-sm text-ink-2">
              <span class="text-ink-3">Aile sağlığı çalışanı:</span> {d.assistant}
            </p>
          </div>

          <div class="mt-4 grid gap-2">
            <a href={telHref(d.phone)} class="btn-secondary w-full justify-between rounded-[12px] px-3.5 tabular-nums">
              <span class="flex items-center gap-2.5">
                <Icon name="phone" class="h-4 w-4 text-accent" />
                {d.phone}
              </span>
              <span class="text-sm text-ink-3">Ara</span>
            </a>
            <Img
              src={schedule(d.slug)}
              label="Haftalık çalışma programı"
              hint="Büyütmek için dokunun"
              alt={`${d.name} haftalık çalışma programı görseli`}
              widths={[720, 1080, 1600]}
            />
            <p class="sr-only">
              {d.name} çalışma programı: Hafta içi Pazartesi–Cuma, yaklaşık {d.hours} saatleri arasında aile hekimliği hizmeti verilir. Gün
              içinde bir saat öğle tatili vardır ve belirli saatlerde ev ziyareti yapılır. Cumartesi ve Pazar kapalıdır. Kesin saatler için
              görseli büyütebilir veya birimi arayabilirsiniz.
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- support team -->
    <h3 class="reveal mt-16 text-lg font-semibold tracking-[-0.01em] text-ink">Destek ekibimiz</h3>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {TEAM.map((t) => (
        <article class="card reveal p-2">
          <div class="overflow-hidden rounded-[12px] bg-surface-2">
            <Image
              src={t.img}
              alt={t.name}
              class:list={['aspect-[4/3] w-full object-cover', t.crop]}
              widths={[320, 480, 640, 760]}
              sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 92vw"
            />
          </div>
          <div class="px-3 pt-4 pb-3">
            <h4 class="text-lg font-semibold tracking-[-0.01em] text-ink">{t.name}</h4>
            <p class="mt-1 text-sm text-ink-2">{t.role}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Arriving from the list above: a ring that fades out, so the eye lands on the right card. */
  .doctor:target {
    animation: arrive 1400ms var(--ease-out);
  }
  @keyframes arrive {
    from {
      box-shadow:
        0 0 0 3px var(--color-accent),
        var(--elev-2);
    }
  }
</style>
