---
/**
 * The map is a picture, not a map widget. scripts/map/render.mjs draws it from
 * OpenStreetMap data (Protomaps basemap), centred on LOCATION, and the site serves
 * it like any other image, so showing it sends nothing to a map company and needs
 * no JS, API key or consent. Directions open in the visitor's own map app through
 * the DIRECTIONS links in Contact.astro. ODbL asks for the OpenStreetMap credit
 * on the map itself.
 */
import { getImage } from 'astro:assets';
import mapLight from '../assets/images/map/map-light.webp';
import mapDark from '../assets/images/map/map-dark.webp';
import { SHORT_NAME } from '../lib/clinic';

// The render is a 1120×720 canvas at 2x. Shown at its own size and centred, the box
// crops it instead of scaling it, so labels keep their size at every breakpoint.
const WIDTH = 1120;
const HEIGHT = 720;
const options = { width: WIDTH, height: HEIGHT, densities: [1, 2], format: 'webp' as const };
const [light, dark] = await Promise.all([getImage({ src: mapLight, ...options }), getImage({ src: mapDark, ...options })]);
---

<div class="relative h-[360px] w-full overflow-hidden bg-surface-2 md:h-[480px] lg:h-full lg:min-h-[480px]">
  <picture>
    <source media="(prefers-color-scheme: dark)" srcset={dark.srcSet.attribute} width={WIDTH} height={HEIGHT} />
    <img
      src={light.src}
      srcset={light.srcSet.attribute}
      width={WIDTH}
      height={HEIGHT}
      alt={`${SHORT_NAME}’nin Ulucak’taki konumunu gösteren harita`}
      loading="lazy"
      decoding="async"
      class="absolute top-1/2 left-1/2 min-h-full max-w-none min-w-full -translate-x-1/2 -translate-y-1/2 object-cover"
    />
  </picture>

  <!-- the pin's tip sits on the image centre, which is LOCATION -->
  <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-[18px] -translate-y-full" aria-hidden="true">
    <div class="flex items-start gap-2">
      <svg class="map-pin h-[46px] w-9 text-seal" viewBox="0 0 36 46">
        <path fill="currentColor" d="M18 45C18 45 34 30.5 34 17.5 34 8 26.8 1 18 1S2 8 2 17.5C2 30.5 18 45 18 45Z" />
        <circle cx="18" cy="17.5" r="6.5" fill="#fff" />
      </svg>
      <span class="map-label mt-1.5 rounded-full bg-surface px-3 py-1 text-[13px] font-semibold whitespace-nowrap text-ink">
        Özdurakoğlu ASM
      </span>
    </div>
  </div>

  <a
    href="https://www.openstreetmap.org/copyright"
    target="_blank"
    rel="noopener noreferrer"
    class="absolute right-2 bottom-2 rounded-md bg-surface/85 px-1.5 py-0.5 text-[11px] text-ink-2 hover:text-ink"
  >
    © OpenStreetMap
  </a>
</div>

<style>
  .map-pin {
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.25)) drop-shadow(0 8px 12px rgb(0 0 0 / 0.15));
  }
  .map-label {
    box-shadow: var(--elev-2);
  }
</style>
