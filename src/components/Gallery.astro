---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import frontSide from '../assets/images/asm/front-side.webp';
import interior1 from '../assets/images/asm/interior-1.webp';
import interior2 from '../assets/images/asm/interior-2.webp';
import interior3 from '../assets/images/asm/interior-3.webp';
import interior4 from '../assets/images/asm/interior-4.webp';
import interior5 from '../assets/images/asm/interior-5.webp';

const images = [
  { src: frontSide, alt: 'Ön görünüş', caption: 'Ön görünüş' },
  { src: interior1, alt: 'ASM içi', caption: 'İç mekan' },
  { src: interior2, alt: 'ASM içi', caption: 'İç mekan' },
  { src: interior3, alt: 'ASM içi', caption: 'İç mekan' },
  { src: interior4, alt: 'ASM içi', caption: 'İç mekan' },
  { src: interior5, alt: 'ASM içi', caption: 'İç mekan' },
];
---

<section id="merkezimiz" class="scroll-mt-20 py-14 md:py-20">
  <div class="wrap">
    <h2 class="max-w-[46rem] text-title text-ink">
      Yeni binamız. <span class="text-ink-3">Ulucak'ta, modern ve kolay ulaşılabilir.</span>
    </h2>

    <div class="mt-10 grid grid-cols-2 gap-2 md:gap-3 lg:grid-cols-3">
      {
        images.map((image, index) => (
          <button
            type="button"
            class:list={['gallery-item relative block overflow-hidden rounded-[14px] bg-surface-2', index === 0 && 'col-span-2 lg:row-span-2']}
            data-src={image.src.src}
            data-alt={image.alt}
            aria-label={`${image.caption} görselini büyüt`}
          >
            <Image
              src={image.src}
              alt={image.alt}
              class="aspect-[4/3] h-full w-full object-cover"
              sizes={index === 0 ? '(min-width: 1152px) 760px, (min-width: 1024px) 66vw, 100vw' : '(min-width: 1152px) 380px, (min-width: 1024px) 33vw, 50vw'}
              widths={[360, 540, 720, 960]}
            />
          </button>
        ))
      }
    </div>
  </div>

  <!-- one shared viewer; each tile hands it the full-size original -->
  <dialog id="gallery-viewer" class="lightbox gallery-viewer" aria-label="Görsel önizleme">
    <img alt="" />
    <button type="button" class="lightbox-close" aria-label="Kapat">
      <Icon name="close" class="h-5 w-5" />
    </button>
  </dialog>
</section>

<style>
  .gallery-item {
    cursor: zoom-in;
    transition: transform 160ms var(--ease-out);
  }
  /* hairline edge drawn above the photo so light walls don't bleed into the page */
  .gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    pointer-events: none;
  }
  .gallery-item img {
    transition: transform 400ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .gallery-item:hover img {
      transform: scale(1.03);
    }
  }
  .gallery-item:active {
    transform: scale(0.985);
  }

  .gallery-viewer {
    padding: 1rem;
    align-items: center;
    justify-content: center;
  }
  .gallery-viewer[open] {
    display: flex;
  }
  /* the photo settles from 0.96 as the viewer fades in */
  .gallery-viewer img {
    max-height: 88dvh;
    max-width: min(92vw, 1400px);
    object-fit: contain;
    border-radius: 12px;
    transform: scale(0.96);
    transition: transform 220ms var(--ease-out);
  }
  .gallery-viewer[open] img {
    transform: none;
  }
  @starting-style {
    .gallery-viewer[open] img {
      transform: scale(0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-item:active,
    .gallery-item:hover img,
    .gallery-viewer img,
    .gallery-viewer[open] img {
      transform: none;
    }
    @starting-style {
      .gallery-viewer[open] img {
        transform: none;
      }
    }
  }
</style>

<script>
  const viewer = document.getElementById('gallery-viewer') as HTMLDialogElement;
  const photo = viewer.querySelector('img')!;

  document.querySelectorAll<HTMLButtonElement>('.gallery-item').forEach((item) => {
    item.addEventListener('click', () => {
      photo.src = item.dataset.src!;
      photo.alt = item.dataset.alt!;
      viewer.showModal();
    });
  });

  viewer.querySelector('.lightbox-close')!.addEventListener('click', () => viewer.close());
  // a click on the backdrop (outside the photo) closes
  viewer.addEventListener('click', (e) => {
    if (e.target === viewer) viewer.close();
  });
</script>
