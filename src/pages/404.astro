---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Astro/Header.astro';
import Footer from '../components/Astro/Footer.astro';
---

<Layout
  title="Sayfa bulunamadı | İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi"
  description="Aradığınız sayfa bulunamadı. Ana sayfaya dönebilir veya bizimle iletişime geçebilirsiniz."
>
  <Header>
    <section class="flex min-h-[60svh] items-center py-16 md:py-24">
      <div class="wrap-tight">
        <span class="chip bg-surface-2 text-ink-2">404</span>
        <h1 class="mt-6 text-display text-ink">Bu sayfa mevcut değil</h1>
        <p class="mt-5 max-w-[56ch] text-lead text-ink-2">
          Aradığınız sayfa taşınmış, adı değişmiş veya hiç var olmamış olabilir. Aşağıdaki bağlantılardan devam edebilirsiniz.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="/" class="btn-primary">Ana sayfaya dön</a>
          <a href="/#iletisim" class="btn-secondary">İletişime geç</a>
        </div>
      </div>
    </section>
  </Header>
  <Footer />
</Layout>
