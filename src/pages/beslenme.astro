---
import { Image } from 'astro:assets';
import kids from '../assets/images/asm/kids.jpeg';

import Layout from '../layouts/Layout.astro';
import Header from '../components/Astro/Header.astro';
import Footer from '../components/Astro/Footer.astro';

const maxSaglik = ['Yeterli ve dengeli beslenme', 'Düzenli fiziksel aktivite', 'Sigarasız yaşam', 'Stresten uzak durma', 'Düzenli sağlık kontrolü'];

const dengeli = [
  'Sağlam ve sağlıklı bir görünüş',
  'Hareketli ve esnek bir beden',
  'Muntazam cilt, canlı ve parlak saç ve gözler',
  'Kuvvetli, gelişimi normal kaslar',
  'Çalışmaya istekli bir kişilik',
  'Boya uygun vücut ağırlığı',
  'Normal zihinsel gelişim',
  'Sık sık hasta olmayan bir yapı',
];

const dengesiz = [
  'Ağır ve isteksiz hareketler',
  'Sağlıksız genel görünüş (aşırı zayıf veya şişman)',
  'Pürüzlü, kuru, sağlıksız cilt',
  'Şişman veya zayıf vücut yapısı',
  'Sık sık baş ağrısı şikâyeti',
  'İştahsız, yorgun, isteksiz bir yapı',
];
---

<Layout
  title="Beslenme ve Obezite | İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi"
  description="Yeterli ve dengeli beslenme ile sağlıklı yaşam önerileri; beslenme ve obezite hakkında bilgilendirme."
>
  <Header>
    <!-- page header band -->
    <section class="relative overflow-hidden bg-pine-deep text-paper">
      <div class="wrap-tight py-14 md:py-20">
        <a href="/" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.16em] text-sage/70 transition-colors hover:text-paper">
          <span aria-hidden="true">←</span> Ana sayfa
        </a>
        <p class="eyebrow-on-dark mt-8">Koruyucu Sağlık</p>
        <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight md:text-6xl">Beslenme ve Obezite</h1>
        <p class="mt-6 font-display text-2xl font-semibold text-seal-soft md:text-3xl">"Minimum hastalık riski, maksimum sağlık."</p>
      </div>
    </section>

    <section class="bg-paper py-16 md:py-20">
      <div class="wrap-tight">
        <div class="overflow-hidden border border-line">
          <Image class="aspect-[16/9] w-full object-cover" src={kids} alt="Sağlıklı beslenen çocuklar" widths={[480, 720, 960]} sizes="(min-width: 768px) 720px, 90vw" loading="eager" decoding="async" />
        </div>

        <!-- maksimum sağlık için -->
        <div class="mt-14">
          <p class="eyebrow">Maksimum sağlık için</p>
          <ul class="mt-6 divide-y divide-line border-y border-line">
            {
              maxSaglik.map((item) => (
                <li class="flex items-center gap-4 py-4">
                  <span class="unit-code text-pine" />
                  <span class="text-lg text-ink">{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-14 space-y-5 text-lg leading-relaxed text-ink-soft">
          <p>Optimal sağlık için yaşamın her döneminde yeterli ve dengeli beslenme temel unsurdur.</p>
          <p>
            Beslenme; açlık duygusunu bastırmak ya da canının çektiğini yemek değildir. Sağlığı korumak, geliştirmek ve yaşam kalitesini
            yükseltmek için vücudun gereksinim duyduğu besin öğelerini yeterli miktarda ve uygun zamanda almak için bilinçli yapılan bir
            davranıştır.
          </p>
        </div>

        <!-- compare -->
        <div class="mt-14 grid gap-6 md:grid-cols-2">
          <div class="border border-line bg-sage/50 p-7">
            <h2 class="font-display text-xl font-semibold text-pine">Yeterli ve dengeli beslenenler</h2>
            <ul class="mt-5 space-y-3">
              {
                dengeli.map((item) => (
                  <li class="flex gap-3 text-ink">
                    <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-pine" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="border border-line bg-paper p-7">
            <h2 class="font-display text-xl font-semibold text-seal">Yetersiz ve dengesiz beslenenler</h2>
            <ul class="mt-5 space-y-3">
              {
                dengesiz.map((item) => (
                  <li class="flex gap-3 text-ink">
                    <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 bg-seal" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>
  </Header>
  <Footer />
</Layout>
