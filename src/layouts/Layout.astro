---
import '../styles/global.css';
// Self-hosted fonts (Fontsource) — no request to Google, no visitor IP leaves the site.
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/instrument-sans/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import { capitalizeEachWord } from '../lib/utils.js';
import { TITLE } from '../lib/const.astro';

const isProd = import.meta.env.PROD;
const {
  title = capitalizeEachWord(TITLE),
  description = 'Kemalpaşa İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi: koruyucu sağlık hizmeti, bağışıklama, ayaktan tedavi ve iletişim bilgileri.',
} = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#124a37" />
    <meta name="msapplication-TileColor" content="#124a37" />
    <meta name="theme-color" content="#124a37" />
    {
      isProd && (
        <>
          <link rel="preconnect" href="https://umami.hamzatekin.dev" crossorigin />
          <script defer is:inline async src="https://umami.hamzatekin.dev/script.js" data-website-id="99271bcb-9ff5-49e9-99e8-84ee910a58b4" />
        </>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <slot />
  </body>
</html>
