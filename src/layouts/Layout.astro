---
import '../styles/global.css';
import { capitalizeEachWord } from '../lib/utils.js';
import { TITLE } from '../lib/const.astro';

const isProd = import.meta.env.PROD;
const {
  title = capitalizeEachWord(TITLE),
  description = 'Kemalpaşa İbrahim-Hüsniye Özdurakoğlu Aile Sağlığı Merkezi: koruyucu sağlık hizmeti, bağışıklama, ayaktan tedavi ve iletişim bilgileri.',
} = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover lets the page paint under the notch; content is padded back with env(safe-area-inset-*) -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <!-- status bar / browser chrome matches the header in each scheme -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c100e" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#0e6b4c" />
    <meta name="msapplication-TileColor" content="#0e6b4c" />
    {
      isProd && (
        <>
          <link rel="preconnect" href="https://umami.hamzatekin.dev" crossorigin />
          <script defer is:inline async src="https://umami.hamzatekin.dev/script.js" data-website-id="99271bcb-9ff5-49e9-99e8-84ee910a58b4" />
        </>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <slot />
  </body>
</html>
