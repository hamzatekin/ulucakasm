---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { NAME, SHORT_NAME } from '../lib/clinic';

interface Props {
  /** page name; the clinic name is appended. Omit on the home page. */
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover lets the page paint under the notch; content is padded back with env(safe-area-inset-*) -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <!-- status bar / browser chrome matches the header in each scheme -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c100e" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#0e6b4c" />
    {import.meta.env.PROD && (
      <>
        <link rel="preconnect" href="https://umami.hamzatekin.dev" crossorigin />
        <script is:inline async src="https://umami.hamzatekin.dev/script.js" data-website-id="99271bcb-9ff5-49e9-99e8-84ee910a58b4" />
      </>
    )}
    <title>{title ? `${title} | ${SHORT_NAME}` : NAME}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveal (.reveal in global.css): blocks still below the fold are hidden
      // and play their entrance once as they come into view. Whatever is already on
      // screen is left alone, so the hero stays the only page-load animation.
      const pending = [...document.querySelectorAll<HTMLElement>('.reveal')].filter((el) => el.getBoundingClientRect().top > innerHeight);

      if (pending.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries
              .filter((e) => e.isIntersecting)
              .forEach((e, i) => {
                const el = e.target as HTMLElement;
                io.unobserve(el);
                // a row arriving together cascades left to right, 60ms apart
                el.style.setProperty('--reveal-delay', `${Math.min(i, 4) * 60}ms`);
                // once it has played, drop the attribute so it can never replay
                const settle = (ev: AnimationEvent) => {
                  if (ev.target !== el) return;
                  el.removeAttribute('data-reveal');
                  el.removeEventListener('animationend', settle);
                };
                el.addEventListener('animationend', settle);
                el.dataset.reveal = 'in';
              });
          },
          // fire once the top edge is a little way up from the bottom of the screen
          { rootMargin: '0px 0px -10% 0px' },
        );
        for (const el of pending) {
          el.dataset.reveal = 'hidden';
          io.observe(el);
        }
      }
    </script>
  </body>
</html>
