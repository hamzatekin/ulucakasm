---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { NAME, SHORT_NAME } from '../lib/clinic';

interface Props {
  /** page name; the clinic name is appended. Omit on the home page. */
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover lets the page paint under the notch; content is padded back with env(safe-area-inset-*) -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <!-- status bar / browser chrome matches the header in each scheme -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f7f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c100e" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#0e6b4c" />
    {
      import.meta.env.PROD && (
        <>
          <link rel="preconnect" href="https://umami.hamzatekin.dev" crossorigin />
          <script is:inline async src="https://umami.hamzatekin.dev/script.js" data-website-id="99271bcb-9ff5-49e9-99e8-84ee910a58b4" />
        </>
      )
    }
    <title>{title ? `${title} | ${SHORT_NAME}` : NAME}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
